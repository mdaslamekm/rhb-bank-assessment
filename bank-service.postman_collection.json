	"item": [
		{
			"name": "Create Customer",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"var data = pm.response.json();",
							"pm.test(\"Customer details are correct\", function () {",
							"    pm.expect(data.name).to.eql(\"Mohammed Aslam\");",
							"    pm.expect(data.email).to.eql(\"aslam@gmail.com\");",
							"});",
							"",
							"if (data && data.id) {",
							"    pm.collectionVariables.set(\"customerId\", data.id);",
							"}"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"Mohammed Aslam\",\n  \"email\": \"aslam@gmail.com\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/bank/customers",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"bank",
						"customers"
					]
				}
			},
			"response": []
		},
		{
			"name": "Create Account",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"var data = pm.response.json();",
							"pm.test(\"Account created successfully\", function () {",
							"    pm.expect(data.accountNumber).to.eql(\"ACC123\");",
							"    pm.expect(data.balance).to.eql(1500.00);",
							"    pm.expect(data.customer).to.be.an(\"object\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"accountNumber\": \"ACC123\",\n  \"balance\": 1500.00,\n  \"customerId\": {{customerId}}\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/bank/accounts",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"bank",
						"accounts"
					]
				}
			},
			"response": []
		},
