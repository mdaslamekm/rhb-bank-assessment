							"});",
							"",
							"var data = pm.response.json();",
							"pm.test(\"Search results returned\", function () {",
							"    pm.expect(data.content).to.be.an(\"array\");",
							"    pm.expect(data.content.length).to.be.above(0);",
							"});"
